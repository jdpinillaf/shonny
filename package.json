{
  "name": "shonny",
  "private": true,
  "workspaces": [
    "sitios/*",
    "paquetes/*",
    "datos"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "colapsar": "npm run dev -w colapsar",
    "maquetas": "npx @tailwindcss/cli -i maquetas/entrada.css -o maquetas/estilos.css --watch",
    "ver-maquetas": "python3 -m http.server 8811 --directory maquetas"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3"
  }
}
